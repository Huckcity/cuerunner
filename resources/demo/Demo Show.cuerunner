  "cues": [
    {
      "id": "5c6446b6-7aab-4969-aff6-2c2c7ff27378",
      "number": "1",
      "name": "Walk-in Music",
      "type": "audio",
      "colorLabel": "blue",
      "parentId": null,
      "preWait": 0,
      "postWait": 0,
      "timelineOffset": 0,
      "duration": 4000,
      "advance": "none",
      "isArmed": true,
      "notes": "Fires on GO and loops until cue 8 fades it out: an audio cue does not hold the show. Level, pan, and fade in are on the Audio tab; the loop is on Time & Loops.",
      "filePath": "walk-in.wav",
      "startTime": 0,
      "endTime": null,
      "fadeInDuration": 800,
      "volume": 0.8,
      "pan": 0,
      "outputs": null,
      "loopCount": -1,
      "playbackRate": 1,
      "trim": 1,
      "media": {
        "path": "walk-in.wav",
        "originalPath": ""
      }
    },
    {
      "id": "3210b2e4-ea73-40dd-a6de-fa974471a083",
      "number": "2",
      "name": "Act 1",
      "type": "group",
      "colorLabel": "orange",
      "parentId": null,
      "preWait": 0,
      "postWait": 0,
      "timelineOffset": 0,
      "duration": 0,
      "advance": "none",
      "isArmed": true,
      "notes": "A sequence group: GO fires its children top to bottom. Collapse it with the chevron in its row.",
      "mode": "sequence"
    },
    {
      "id": "57d46fb9-1ed2-469e-966d-05eaccb2385a",
      "number": "3",
      "name": "Count 8",
      "type": "wait",
      "colorLabel": "none",
      "parentId": "3210b2e4-ea73-40dd-a6de-fa974471a083",
      "preWait": 500,
      "postWait": 0,
      "timelineOffset": 0,
      "duration": 8000,
      "advance": "on-end",
      "isArmed": true,
      "notes": "Holds for 8 s, then advances to the next cue by itself. Pre-wait of 500 ms gives the operator a head start."
    },
    {
      "id": "8f58c8c5-f0e5-4444-b61e-e21d710ac17d",
      "number": "4",
      "name": "Strings Patch",
      "type": "midi",
      "colorLabel": "none",
      "parentId": "3210b2e4-ea73-40dd-a6de-fa974471a083",
      "preWait": 0,
      "postWait": 0,
      "timelineOffset": 0,
      "duration": 0,
      "advance": "none",
      "isArmed": true,
      "notes": "Sends a program change. No port is set on this cue, so it uses the default port from Settings — pick one on the MIDI tab.",
      "portName": "",
      "messages": [
        {
          "kind": "programChange",
          "channel": 1,
          "program": 12
        }
      ]
    },
    {
      "id": "e3a4b760-7d38-41d0-acb6-87f67ae226c9",
      "number": "5",
      "name": "LX Cue 12",
      "type": "osc",
      "colorLabel": "none",
      "parentId": "3210b2e4-ea73-40dd-a6de-fa974471a083",
      "preWait": 0,
      "postWait": 0,
      "timelineOffset": 0,
      "duration": 0,
      "advance": "none",
      "isArmed": true,
      "notes": "One OSC message to host:port at an address, with a typed argument list. Sent over UDP, so nothing fails if no desk is listening.",
      "host": "127.0.0.1",
      "port": 53000,
      "address": "/lx/12",
      "args": [
        {
          "type": "i",
          "value": 12
        },
        {
          "type": "f",
          "value": 3.5
        }
      ]
    },
    {
      "id": "c36531bc-f748-46b6-8994-18ee24bda65c",
      "number": "6",
      "name": "Trigger Video",
      "type": "network",
      "colorLabel": "none",
      "parentId": "3210b2e4-ea73-40dd-a6de-fa974471a083",
      "preWait": 0,
      "postWait": 0,
      "timelineOffset": 0,
      "duration": 0,
      "advance": "none",
      "isArmed": true,
      "notes": "POSTs JSON to the URL on the Network tab. Point that URL at your own server — as shipped there is nothing listening on 127.0.0.1:8080, so the cue reports a failure for you to see in the log.",
      "method": "POST",
      "url": "http://127.0.0.1:8080/scene",
      "body": "{\"scene\": 3}",
      "headers": {
        "Content-Type": "application/json",
        "X-Show": "demo"
      },
      "timeout": 5000
    },
    {
      "id": "dce7ea0f-6787-4ff4-b94f-c185b4daea51",
      "number": "7",
      "name": "Scene Change",
      "type": "audio",
      "colorLabel": "none",
      "parentId": "3210b2e4-ea73-40dd-a6de-fa974471a083",
      "preWait": 0,
      "postWait": 0,
      "timelineOffset": 0,
      "duration": 4000,
      "advance": "none",
      "isArmed": true,
      "notes": "The same file, quieter and panned left, to show that level and pan are per cue.",
      "filePath": "walk-in.wav",
      "startTime": 0,
      "endTime": null,
      "fadeInDuration": 300,
      "volume": 0.6,
      "pan": -0.3,
      "outputs": null,
      "loopCount": 0,
      "playbackRate": 1,
      "trim": 1,
      "media": {
        "path": "walk-in.wav",
        "originalPath": ""
      }
    },
    {
      "id": "489ef687-a8f7-4953-a71e-a262e29495bb",
      "number": "8",
      "name": "Fade Walk-in",
      "type": "fade",
      "colorLabel": "none",
      "parentId": null,
      "preWait": 0,
      "postWait": 0,
      "timelineOffset": 0,
      "duration": 5000,
      "advance": "none",
      "isArmed": true,
      "notes": "Ramps the walk-in's volume to zero over 5 s with an S-curve, then stops it — which is what ends its loop. The Fade tab picks the target.",
      "targetCueId": "5c6446b6-7aab-4969-aff6-2c2c7ff27378",
      "fadeProperty": "volume",
      "targetValue": 0,
      "curve": "sCurve",
      "stopTargetWhenDone": true
    },
    {
      "id": "112078f5-168c-455e-894e-e480e17f45bf",
      "number": "9",
      "name": "House Lights",
      "type": "script",
      "colorLabel": "none",
      "parentId": null,
      "preWait": 0,
      "postWait": 0,
      "timelineOffset": 0,
      "duration": 0,
      "advance": "none",
      "isArmed": true,
      "notes": "JavaScript at a cue point. The script is an async function body, so await works; output goes to the log panel.",
      "language": "javascript",
      "script": "console.log('house lights → warm')\nconst r = await shell('echo dimmer 80%')\nconsole.log(r.stdout.trim())",
      "timeout": 60000
    },
