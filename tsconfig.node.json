{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/src/types/**/*",
    "src/renderer/src/utils/scriptDocument.ts",
    "src/renderer/src/utils/waveform.ts",
    "e2e/**/*",
    "scripts/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "types": [
      "electron-vite/node"
    ]
  }
}
