{
  "name": "winslab",
  "version": "0.13.0",
  "license": "FSL-1.1-MIT",
  "description": "QLab-style show control for Windows",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:pro": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-pro.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && node scripts/run-e2e.js",
    "test:e2e:headed": "electron-vite build && node scripts/run-e2e.js --headed",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "screenshots": "electron-vite build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capture-screenshots.mjs",
    "site": "node scripts/serve-website.mjs",
    "license:keygen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/license-keygen.ts keygen",
    "license:issue": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/license-keygen.ts issue",
    "license:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/license-keygen.ts verify",
    "postinstall": "node scripts/postinstall.js",
    "build:native": "node scripts/build-native-audio.mjs",
    "build:ffmpeg": "node scripts/build-ffmpeg-linux.mjs",
    "test:native": "node native/audio/tests/offline.mjs && node native/audio/tests/pace.mjs && node native/audio/tests/stream-seek.mjs && node native/audio/tests/stack.mjs && node native/audio/tests/stream-stall.mjs && node native/audio/tests/matrix-bench.mjs",
    "soak": "node native/audio/tests/soak.mjs",
    "presoak": "node scripts/ensure-native.mjs",
    "soak:report": "node scripts/soak-report.mjs",
    "test:native:device": "node native/audio/tests/device-smoke.mjs",
    "predev": "node scripts/ensure-native.mjs",
    "prebuild": "node scripts/ensure-native.mjs",
    "prepreview": "node scripts/ensure-native.mjs",
    "pretest": "node scripts/ensure-native.mjs",
    "pretest:e2e": "node scripts/ensure-native.mjs",
    "pretest:e2e:headed": "node scripts/ensure-native.mjs",
    "pretest:native": "node scripts/ensure-native.mjs --with-decoders",
    "prescreenshots": "node scripts/ensure-native.mjs",
    "predist": "node scripts/ensure-native.mjs --with-decoders",
    "predist:win": "node scripts/ensure-native.mjs",
    "predist:mac": "node scripts/ensure-native.mjs",
    "predist:linux": "node scripts/ensure-native.mjs --with-decoders",
    "ensure:native": "node scripts/ensure-native.mjs --with-decoders",
    "pretest:native:device": "node scripts/ensure-native.mjs"
  },
  "build": {
    "appId": "com.winslab.app",
    "productName": "WinsLab",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/demo",
        "to": "demo"
      },
      {
        "from": "native/audio/build",
        "to": "audio",
        "filter": [
          "winslab-audio",
          "winslab-audio.exe",
          "decoders/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.music"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "resources/logos/png/winslab-icon-512.png"
    },
    "publish": null
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "midi": true
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "node-osc": "^11.4.0",
    "zustand": "^5.0.0"
  },
  "optionalDependencies": {
    "midi": "^2.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.59.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tanstack/react-virtual": "^3.10.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
